# Railway Production Environment Variables
# Copy these to your Railway project environment variables

# Flask Configuration
SECRET_KEY=your-production-secret-key-change-this
FLASK_ENV=production
FLASK_DEBUG=False

# Database Configuration (Railway will provide DATABASE_URL automatically)
# DATABASE_URL will be set by Railway PostgreSQL service

# Optional: Custom domain (if you have one)
# CUSTOM_DOMAIN=your-domain.com

# Optional: Email configuration for notifications
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=True
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password
